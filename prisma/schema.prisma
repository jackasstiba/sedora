// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Item {
  id            Int      @id @default(autoincrement())
  source        String
  sourceId      String
  title         String
  genre         String
  subGenre      String?
  eventType     String
  eventDate     DateTime?
  eventDateText String?
  price         String?
  url           String
  imageUrl      String?
  scrapedAt     DateTime @default(now())

  // 相場（中古市場価格）。発売済み商品に対してベストエフォートで付与する。
  // 未発売品には市場が無いため null のまま（＝表示しない）。source非依存の汎用列。
  marketPrice     Int?      // 代表価格（円・数値）。ソート/急上昇の将来利用向け
  marketPriceText String?   // 表示用ラベル（例: "中古 ¥3,980"）
  marketUrl       String?   // 相場元の商品ページ
  marketSource    String?   // "surugaya" など
  marketCheckedAt DateTime? // 相場を取得した時刻

  // コラボ記事本文から抽出した“深い”情報。イベント1行では拾えない賞品ラインナップの要約。
  // 例: ホロライブ×極楽湯 → highlights="抽選・ランダム賞品：マフラータオル / …", hasLottery=true。
  highlights  String?  // カード/詳細に出す注目賞品の要約（抽選/ランダム/数量限定を含む）
  hasLottery  Boolean? // 抽選・ランダム性のある賞品を含む（抽選タブで拾う）

  @@unique([source, sourceId])
  @@index([genre])
  @@index([eventDate])
}
