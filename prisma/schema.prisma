// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Item {
  id            Int      @id @default(autoincrement())
  source        String
  sourceId      String
  title         String
  genre         String
  subGenre      String?
  eventType     String
  eventDate     DateTime?
  eventDateText String?
  price         String?
  url           String
  imageUrl      String?
  scrapedAt     DateTime @default(now())

  // 相場（中古市場価格）。発売済み商品に対してベストエフォートで付与する。
  // 未発売品には市場が無いため null のまま（＝表示しない）。source非依存の汎用列。
  marketPrice     Int?      // 代表価格（円・数値）。ソート/急上昇の将来利用向け
  marketPriceText String?   // 表示用ラベル（例: "中古 ¥3,980"）
  marketUrl       String?   // 相場元の商品ページ
  marketSource    String?   // "surugaya" など
  marketCheckedAt DateTime? // 相場を取得した時刻

  // コラボ記事本文から抽出した“深い”情報。イベント1行では拾えない賞品ラインナップの要約。
  // 例: ホロライブ×極楽湯 → highlights="抽選・ランダム賞品：マフラータオル / …", hasLottery=true。
  highlights  String?  // カード/詳細に出す注目賞品の要約（抽選/ランダム/数量限定を含む）
  hasLottery  Boolean? // 抽選・ランダム性のある賞品を含む（抽選タブで拾う）
  officialUrl String?  // 記事から辿った一次情報（公式キャンペーン/ストア）ページ

  // 一番くじの各等賞ラインナップ（構造化）。JSON配列文字列で保持する:
  //   [{label:"A賞", name:"…", image:"https://…", resalePrice?:15500,
  //     resaleText?:"中古 ¥15,500", resaleUrl?:"https://…", resaleSource?:"surugaya"}]
  // 賞画像ギャラリー＋賞ごとの二次相場（駿河屋バラ売り）を商品詳細で表示するため。
  prizes String?

  // 家電・ゲーム機など「複数の小売が同時に抽選/予約応募を実施する」商品の、
  // 現在“受付中”の公式ストア一覧（構造化）。JSON配列文字列で保持する:
  //   [{name:"Amazon", url:"https://…(公式)", form:"招待制販売", when:"9/5 17:00〜"}]
  // 一次ソース(各小売の抽選ページ)へ直リンクし、アグリゲーターは表に出さない設計。
  stores String?

  @@unique([source, sourceId])
  @@index([genre])
  @@index([eventDate])
}

// 自前アクセス解析イベント。Vercel Web Analytics のカスタムイベントは Hobby プランでは
// API 取得が Pro 限定(HTTP402)で Claude が読めないため、ユーザー操作イベントだけを
// Turso に直接記録し `npm run analytics` から読めるようにする（PV/流入元/デバイスは
// 引き続き Vercel から取得＝二重記録しない）。書き込みはユーザー操作時のみ＝低ボリューム。
model Event {
  id        Int      @id @default(autoincrement())
  name      String   // "genre_select" | "search" | "outbound_click"
  value     String?  // 主要ディメンション（genre名 / 検索語 / 導線kind）
  data      String?  // 補助情報のJSON（source/itemId 等）
  path      String?  // 発生ページのパス
  createdAt DateTime @default(now())

  @@index([name, createdAt])
}
