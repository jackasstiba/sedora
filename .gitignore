# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite db & scraper logs
*.db
*.db-journal
scrape_log.txt
# scrape health check (local run state)
scrape_health.json
scrape_health.log
# X巡回の受け皿（機微な巡回メモを含む。exampleのみコミット）
scripts/x_watch/x_watch_inbox.json

# prisma-installed agent skill packs (dev tooling, not needed for deploy)
/.agents/
/.claude/
/.windsurf/
/skills-lock.json
# 監査の観測プロファイル（ローカルの実行状態。前回との差分検出に使う）
audit-profile.json
sweep-dump.txt

# 使い捨ての調査スクリプト（_ 始まり / scratch_）。コミットに紛れ込ませない
scripts/_*.ts
scratch_*.mjs
